# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ─── Cache/Queue (Upstash Redis — native Redis protocol, required by BullMQ) ──
# Get from: Upstash Console → your Redis DB → Connect → ioredis
# Format: rediss://:password@hostname:port
UPSTASH_REDIS_URL=rediss://:xxx@xxx.upstash.io:6380

# ─── Encryption ──────────────────────────────────────────────────────────────
# Must match ENCRYPTION_KEY in apps/web exactly.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-string-here

# ─── Internal service auth ────────────────────────────────────────────────────
# Shared secret for web → ingest server-to-server calls
INGEST_INTERNAL_SECRET=xxx

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
